# Vertex AI Configuration
# Set to 1 to use Vertex AI (GCP), 0 to use Google AI Studio
GOOGLE_GENAI_USE_ENTERPRISE=1

# Your Google Cloud Project ID
# Find it at: https://console.cloud.google.com/
GOOGLE_CLOUD_PROJECT=your-project-id

# GCP region for deployment
# Supported regions: us-central1, us-west1, europe-west1, asia-northeast1
# See: https://cloud.google.com/vertex-ai/docs/general/locations
GOOGLE_CLOUD_LOCATION=us-west1

# Agent Deployment Settings
# Display name for your agent in GCP Console
AGENT_DISPLAY_NAME=my-agent-name
