# Configuration for the CX Agent Studio TAC server. Copy to .env and fill in.

# ---- GCP (used by the deploy scripts) ----
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=your-region

# ---- CX Agent Studio agent ----
# The agent resource name, from the CES console (see agent/README.md).
CX_AGENT_ID=projects/your-project/locations/your-location/apps/your-app-id

# ---- Twilio ----
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=your_api_secret
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_CONVERSATION_CONFIGURATION_ID=conv_configuration_xxxx

# ---- Server: deploy knobs (optional; script-only, not passed to the app) ----
# CLOUD_RUN_SERVICE=tac-cx-server
# ARTIFACT_REPO=tac
# Deploy SA override. Default (unset) = tac-deployer@<project> (make create-sa).
# DEPLOY_SERVICE_ACCOUNT=other-sa@your-project-id.iam.gserviceaccount.com

# NOTE (server): do NOT set PORT / TWILIO_SERVER_PORT (Cloud Run manages the port),
# TWILIO_VOICE_PUBLIC_DOMAIN (deploy.sh fills it), or GOOGLE_APPLICATION_CREDENTIALS
# (Cloud Run uses the service account's ADC).
