# GCP Configuration
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# GCP Agent Platform Runtime (Reasoning Engine)
GCP_REASONING_ENGINE_ID=your-reasoning-engine-id

# Optional: Path to service account key (uses ADC if not set)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Twilio Configuration
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=your_api_secret
TWILIO_PHONE_NUMBER=+12345678900
TWILIO_CONVERSATION_CONFIGURATION_ID=conv_configuration_xxxxxxxxxxxxxxxx

# Optional: only needed for the WhatsApp example (features/whatsapp.py)
# TWILIO_WHATSAPP_NUMBER=whatsapp:+12345678900

# Optional: only needed for the RCS example (features/rcs.py)
# TWILIO_RCS_SENDER_ID=rcs_sender_xxxxxxxxxxxxxxxxxx

# Server Configuration (required for Voice channel)
TWILIO_VOICE_PUBLIC_DOMAIN=your-domain.ngrok.io
